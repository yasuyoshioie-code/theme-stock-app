# .streamlit/secrets.toml テンプレート
#
# 利用方法:
#   1. このファイルを secrets.toml にコピーし、値を埋める
#   2. secrets.toml は .gitignore 済み — 絶対に commit しない
#   3. Streamlit Cloud では「Settings > Secrets」に同じ内容を貼り付ける

# 四季報オンライン プレミアム Cookie（任意）
#   DevTools > Network > shikiho.toyokeizai.net のリクエスト > Request Headers > cookie: の値
shikiho_premium_cookie = ""
